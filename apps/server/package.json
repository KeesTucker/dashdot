{
  "name": "@dashdot/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"yarn build:watch\" \"nodemon dist/index.mjs\"",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --sourcemap --banner:js=\"import { createRequire as __esmCreateRequire } from 'node:module'; import { fileURLToPath as __esmFileURLToPath } from 'node:url'; import { dirname as __esmDirname } from 'node:path'; const require = __esmCreateRequire(import.meta.url); const __filename = __esmFileURLToPath(import.meta.url); const __dirname = __esmDirname(__filename);\"",
    "build:watch": "yarn build --watch",
    "start": "node dist/index.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@dashdot/common": "*",
    "@dashdot/typescript-config": "*",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "cronstrue": "3.38.0",
    "dedent": "1.7.2",
    "express": "5.3.0",
    "mime-types": "3.0.2",
    "node-cron": "4.6.0",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "systeminformation": "5.33.16"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/compression": "^1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jest": "30.0.0",
    "@types/mime-types": "^3",
    "@types/node": "25.9.9",
    "chai": "6.3.0",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
